# =====================================================
# .env.local — DESENVOLVIMENTO LOCAL
# =====================================================
# 
# Este arquivo é para desenvolvimento LOCAL apenas.
# NUNCA faça commit deste arquivo — está no .gitignore
# 
# Copie este arquivo para .env.local e preencha os valores.

# ========================
# MODO PADRÃO: CPT + ACF (NOVO WORDPRESS)
# ========================
# Use isto se estiver testando a estrutura final CPT/ACF
VITE_WP_API_URL=http://localhost:10003/wp-json/wp/v2


# ========================
# MODO LEGADO: POSTS + CATEGORIAS (SITE ANTIGO)
# ========================
# Descomente os blocos abaixo para consumir dados do site antigo
# (posts organizados por categorias em vez de CPT/ACF)

# Ativa modo legado (DESENVOLVIMENTO APENAS)
# VITE_DATA_SOURCE=legacy

# Base da API do site antigo
# VITE_WP_LEGACY_API_URL=https://fundacao193.org.br/wp-json/wp/v2

# IDs das categorias no site antigo (procure na dashboard: Posts → Categorias)
# Exemplo: se a categoria "Blog" tem ID 14, use:
# VITE_WP_LEGACY_CATEGORY_NEWS=14
# VITE_WP_LEGACY_CATEGORY_PROJECTS=15
# VITE_WP_LEGACY_CATEGORY_EVENTS=16
# VITE_WP_LEGACY_CATEGORY_PARTNERS=17
# VITE_WP_LEGACY_CATEGORY_TRAINING=18

# Limite de itens por fetch (padrão 50)
# VITE_WP_LEGACY_PER_PAGE=50
