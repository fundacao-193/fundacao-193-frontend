# Configuracao do WordPress REST API
# Aponta para a instalacao WordPress com tema customizado e campos ACF 
# Local development: use Local WP ou outra instancia de WordPress local
VITE_WP_API_URL=http://localhost:10003/wp-json/wp/v2

# Producao: atualize para o dominio WordPress em producao
# Exemplo: VITE_WP_API_URL=https://api.fundacao193.org.br/wp-json/wp/v2