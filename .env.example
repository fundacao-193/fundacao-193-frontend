# =====================================================
# CONFIGURAÇÃO PADRÃO — CPT + ACF (Novo WordPress)
# =====================================================
# Para desenvolvimento local com o novo WordPress (estrutura final)
VITE_WP_API_URL=http://localhost:10003/wp-json/wp/v2

# Para produção, atualize com o domínio real:
# VITE_WP_API_URL=https://api.fundacao193.org.br/wp-json/wp/v2

# =====================================================
# MODO LEGADO — Posts + Categorias (Site Antigo)
# =====================================================
# Use apenas durante desenvolvimento para consumir o site antigo
# Para ativar, crie .env.local e configure:

# VITE_DATA_SOURCE=legacy

# ⚠️ VALORES DEFAULT JÁ FUNCIONAM!
# O código já tem defaults para https://fundacao193.org.br
# Só configure abaixo se precisar CUSTOMIZAR:

# VITE_WP_LEGACY_API_URL=https://fundacao193.org.br/wp-json/wp/v2
# VITE_WP_LEGACY_CATEGORY_NEWS=14      # Blog (default: 14)
# VITE_WP_LEGACY_CATEGORY_PROJECTS=90  # Projetos (default: 90)
# VITE_WP_LEGACY_CATEGORY_EVENTS=9     # Eventos (default: 9)
# VITE_WP_LEGACY_PER_PAGE=50           # Limite por requisição

# 💡 Para rodar em modo legado SEM .env.local:
#    Basta definir VITE_DATA_SOURCE=legacy no terminal:
#    
#    Windows PowerShell:
#    $env:VITE_DATA_SOURCE='legacy'; npm run dev
#    
#    Linux/Mac:
#    VITE_DATA_SOURCE=legacy npm run dev