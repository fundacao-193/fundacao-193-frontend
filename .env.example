# =====================================================
# CONFIGURAÇÃO PADRÃO — CPT + ACF (Novo WordPress)
# =====================================================
# Para desenvolvimento local com o novo WordPress (estrutura final)
VITE_WP_API_URL=http://localhost:10003/wp-json/wp/v2

# Para produção, atualize com o domínio real:
# VITE_WP_API_URL=https://api.fundacao193.org.br/wp-json/wp/v2

# =====================================================
# MODO LEGADO — Posts + Categorias (Site Antigo)
# =====================================================
# Use apenas durante desenvolvimento para consumir o site antigo
# Para ativar, crie .env.local e defina:

# VITE_DATA_SOURCE=legacy
# VITE_WP_LEGACY_API_URL=https://fundacao193.org.br/wp-json/wp/v2
# VITE_WP_LEGACY_CATEGORY_NEWS=14
# VITE_WP_LEGACY_CATEGORY_PROJECTS=15
# VITE_WP_LEGACY_CATEGORY_EVENTS=16
# VITE_WP_LEGACY_CATEGORY_PARTNERS=17
# VITE_WP_LEGACY_CATEGORY_TRAINING=18
# VITE_WP_LEGACY_PER_PAGE=50

# IMPORTANTE: Descubra os IDs das categorias no WordPress antigo em:
# Dashboard → Posts → Categorias (passe o mouse para ver o ID na URL)